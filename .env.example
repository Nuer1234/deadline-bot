# Copy this file to .env and fill in your own values
#   Windows PowerShell : Copy-Item .env.example .env
#   Linux / Raspberry Pi: cp .env.example .env
#
# The real .env is listed in .gitignore. Never commit it: the token is the key that
# controls the whole bot.

# ---------- required ----------

# Discord Developer Portal -> your application -> Bot tab -> Reset Token
# The token is shown only once, so reset it again if you lose it.
# Turn on MESSAGE CONTENT INTENT on that same page, otherwise the bot comes online
# but never responds to a command.
DISCORD_TOKEN=put_your_token_here

# ---------- optional (these are the defaults; delete any line to use them) ----------

# Prefix for commands. Set it to ? and the commands become ?add, ?list, and so on.
COMMAND_PREFIX=!

# Where tasks are stored. An absolute path works too.
DATA_FILE=data.json

# Hour (Thai time, 0-23) at which the daily digest is posted.
REMINDER_HOUR=8

# How many days before the deadline to warn.
REMINDER_LEAD_DAYS=1

# How often the bot wakes up to check whether the digest is due.
# Set it to 1 while testing the reminder so you see the result quickly.
CHECK_INTERVAL_MINUTES=15
